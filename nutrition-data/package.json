{
  "name": "@equibets/nutrition-data",
  "version": "0.1.0",
  "description": "Standalone equine nutrition data, availability, ration analysis, and recommendation engine for EquiBets.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "REPLIT_INTEGRATION_PROMPT.md",
    ".env.example",
    "docs",
    "examples",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "start": "tsx src/http/start.ts",
    "dev": "tsx watch src/http/start.ts",
    "worker": "tsx src/workers/worker.ts",
    "cli": "tsx src/cli/cli.ts",
    "connector:list": "tsx src/cli/cli.ts connector:list",
    "connector:health": "tsx src/cli/cli.ts connector:health",
    "ingest": "tsx src/cli/cli.ts ingest",
    "recommend": "tsx src/cli/cli.ts recommend",
    "program:analyse": "tsx src/cli/cli.ts program:analyse",
    "manufacturer:list": "tsx src/cli/cli.ts manufacturer:list",
    "manufacturer:health": "tsx src/cli/cli.ts manufacturer:health",
    "manufacturer:status": "tsx src/cli/cli.ts manufacturer:status",
    "manufacturer:assess": "tsx src/cli/cli.ts manufacturer:assess",
    "manufacturer:discover": "tsx src/cli/cli.ts manufacturer:discover",
    "manufacturer:collect": "tsx src/cli/cli.ts manufacturer:collect",
    "manufacturer:smoke": "tsx src/cli/cli.ts manufacturer:smoke",
    "manufacturer:persist-smoke": "tsx src/cli/cli.ts manufacturer:persist-smoke",
    "manufacturer:acceptance": "tsx src/cli/cli.ts manufacturer:acceptance",
    "manufacturer:refresh": "tsx src/cli/cli.ts manufacturer:refresh",
    "manufacturer:workboard": "tsx src/cli/cli.ts manufacturer:workboard",
    "australia:acceptance-report": "tsx src/cli/cli.ts australia:acceptance-report",
    "product:refresh": "tsx src/cli/cli.ts product:refresh",
    "product:versions": "tsx src/cli/cli.ts product:versions",
    "availability:refresh": "tsx src/cli/cli.ts availability:refresh",
    "availability:stale": "tsx src/cli/cli.ts availability:stale",
    "price:refresh": "tsx src/cli/cli.ts price:refresh",
    "mappings:inspect": "tsx src/cli/cli.ts mappings:inspect",
    "mappings:test": "tsx src/cli/cli.ts mappings:test",
    "formulations:changed": "tsx src/cli/cli.ts formulations:changed",
    "formulation:changes": "tsx src/cli/cli.ts formulation:changes",
    "forage-lab:import": "tsx src/cli/cli.ts forage-lab:import",
    "forage-lab:validate": "tsx src/cli/cli.ts forage-lab:validate",
    "backfill:plan": "tsx src/cli/cli.ts backfill:plan",
    "backfill:start": "tsx src/cli/cli.ts backfill:start",
    "worker:discovery": "tsx src/cli/cli.ts worker:discovery",
    "worker:products": "tsx src/cli/cli.ts worker:products",
    "worker:availability": "tsx src/cli/cli.ts worker:availability",
    "worker:prices": "tsx src/cli/cli.ts worker:prices",
    "worker:recalculate": "tsx src/cli/cli.ts worker:recalculate",
    "worker:outbox": "tsx src/cli/cli.ts worker:outbox",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:consumer": "tsx tests/consumer/runConsumerIntegration.ts",
    "demo": "tsx src/demo/runDemo.ts",
    "smoke:live": "NUTRITION_LIVE_SMOKE=1 vitest run --config vitest.live.config.ts tests/live/liveSmoke.test.ts",
    "test:postgres:live-au": "NUTRITION_LIVE_POSTGRES=1 vitest run --config vitest.live.config.ts tests/live/postgresAustralianLiveAcceptance.test.ts",
    "migrate": "node scripts/print-migration-instructions.js",
    "export:zip": "node scripts/create-export.mjs"
  },
  "keywords": [
    "equibets",
    "equine",
    "nutrition",
    "feed",
    "recommendations",
    "availability"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.10.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "vitest": "latest"
  }
}
