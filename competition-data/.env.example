EQUIBETS_COMPETITION_DATA_BATCH_PREFIX=competition-data
EQUIBETS_COMPETITION_DATA_DEFAULT_COUNTRIES=AU,NZ,GB,US

# Comma-separated connector ids. Every connector is individually disableable.
EQUIBETS_COMPETITION_DATA_CONNECTORS=fei-public-feed,national-results-feed

EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_ENABLED=false
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_SOURCE_ID=fei-public
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_SOURCE_NAME=FEI public information
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_SOURCE_KIND=fei
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_MODE=official_feed
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_OFFICIAL=true
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_SOURCE_URL=https://inside.fei.org/
EQUIBETS_COMPETITION_DATA_FEI_PUBLIC_FEED_ENDPOINTS=

EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_ENABLED=false
EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_SOURCE_ID=national-results
EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_SOURCE_NAME=National results feed
EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_SOURCE_KIND=national_federation
EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_MODE=public_file
EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_OFFICIAL=true
EQUIBETS_COMPETITION_DATA_NATIONAL_RESULTS_FEED_ENDPOINTS=

# Optional standalone HTTP service auth.
COMPETITION_DATA_ENGINE_API_KEY=
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/equibets_competition_data
COMPETITION_DATA_DB_POOL_MAX=10

# HTTP/API limits
COMPETITION_DATA_BODY_LIMIT_BYTES=1048576
COMPETITION_DATA_FILE_LIMIT_BYTES=5242880
COMPETITION_DATA_RATE_LIMIT_REQUESTS=120
COMPETITION_DATA_RATE_LIMIT_WINDOW_MS=60000

# Public URL import safety
COMPETITION_DATA_ALLOWED_URL_PROTOCOLS=http,https
COMPETITION_DATA_PUBLIC_URL_TIMEOUT_MS=30000
COMPETITION_DATA_PUBLIC_URL_REDIRECT_LIMIT=3
COMPETITION_DATA_PUBLIC_URL_USER_AGENT=EquiBetsCompetitionDataEngine/0.1.0

# Matching and reconciliation
COMPETITION_DATA_AUTOMATIC_MATCH_THRESHOLD=0.82
COMPETITION_DATA_REVIEW_MATCH_THRESHOLD=0.58
COMPETITION_DATA_HISTORICAL_BACKFILL_DAYS=3650

# Retry/cache/retention
COMPETITION_DATA_RETRY_MAX_ATTEMPTS=3
COMPETITION_DATA_RETRY_INITIAL_DELAY_MS=500
COMPETITION_DATA_RETRY_MAX_DELAY_MS=10000
COMPETITION_DATA_CACHE_TTL_MS=60000
COMPETITION_DATA_RAW_PAYLOAD_RETENTION_DAYS=90
COMPETITION_DATA_LOG_REDACTION_KEYS=authorization,cookie,set-cookie,password,token,apiKey

# Worker
COMPETITION_DATA_WORKER_INTERVAL_MS=300000
COMPETITION_DATA_OUTBOX_INTERVAL_MS=30000
COMPETITION_DATA_OUTBOX_MAX_ATTEMPTS=5
COMPETITION_DATA_CORS_ORIGIN=
COMPETITION_DATA_REQUIRE_AUTH=true
