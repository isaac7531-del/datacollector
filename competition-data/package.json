{
  "name": "@equibets/competition-data",
  "version": "0.2.0",
  "description": "Portable competition-data ingestion and reconciliation package for EquiBets.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "REPLIT_HANDOFF.md",
    ".env.example",
    "docs",
    "examples",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/*.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:postgres": "REQUIRE_POSTGRES_TESTS=1 vitest run tests/integration/postgresRepository.test.ts tests/integration/postgresOperational.test.ts",
    "test:consumer": "tsx tests/consumer/runConsumerIntegration.ts",
    "start": "tsx src/http/start.ts",
    "dev": "tsx watch src/http/start.ts",
    "worker": "tsx src/workers/worker.ts",
    "worker:discovery": "tsx src/workers/sourceWorker.ts discovery",
    "worker:collection": "tsx src/workers/sourceWorker.ts collection",
    "worker:processing": "tsx src/workers/sourceWorker.ts processing",
    "worker:provisional": "tsx src/workers/sourceWorker.ts provisional",
    "worker:backfill": "tsx src/workers/sourceWorker.ts backfill",
    "worker:outbox": "tsx src/workers/outboxWorker.ts",
    "outbox:retry": "tsx src/cli/cli.ts outbox:retry",
    "outbox:dead-letter": "tsx src/cli/cli.ts outbox:dead-letter",
    "demo": "tsx src/demo/runDemo.ts",
    "cli": "tsx src/cli/cli.ts",
    "connector:list": "tsx src/cli/cli.ts connector:list",
    "connector:health": "tsx src/cli/cli.ts connector:health",
    "source:list": "tsx src/cli/cli.ts source:list",
    "source:health": "tsx src/cli/cli.ts source:health",
    "source:status": "tsx src/cli/cli.ts source:status",
    "source:assess": "tsx src/cli/cli.ts source:assess",
    "source:discover": "tsx src/cli/cli.ts source:discover",
    "source:collect-event": "tsx src/cli/cli.ts source:collect-event",
    "source:persist-smoke": "tsx src/cli/cli.ts source:persist-smoke",
    "source:acceptance": "tsx src/cli/cli.ts source:acceptance",
    "source:smoke": "tsx src/cli/cli.ts source:smoke",
    "backfill:plan": "tsx src/cli/cli.ts backfill:plan",
    "backfill:start": "tsx src/cli/cli.ts backfill:start",
    "backfill:pause": "tsx src/cli/cli.ts backfill:pause",
    "backfill:resume": "tsx src/cli/cli.ts backfill:resume",
    "import:file": "tsx src/cli/cli.ts import:file",
    "import:url": "tsx src/cli/cli.ts import:url",
    "backfill": "tsx src/cli/cli.ts backfill",
    "reprocess:failed": "tsx src/cli/cli.ts reprocess:failed",
    "reprocess:unresolved": "tsx src/cli/cli.ts reprocess:unresolved",
    "provisional:recheck": "tsx src/cli/cli.ts provisional:recheck",
    "migrate": "tsx src/cli/migrate.ts up",
    "migrate:rollback": "tsx src/cli/migrate.ts rollback",
    "seed": "tsx src/cli/seed.ts",
    "mapping:inspect": "tsx src/cli/cli.ts mapping:inspect",
    "mapping:preview": "tsx src/cli/cli.ts mapping:preview",
    "mapping:test": "tsx src/cli/cli.ts mapping:test",
    "mapping:export": "tsx src/cli/cli.ts mapping:export",
    "mapping:import": "tsx src/cli/cli.ts mapping:import",
    "import:rollback-plan": "tsx src/cli/cli.ts import:rollback-plan",
    "import:rollback": "tsx src/cli/cli.ts import:rollback",
    "browser-collector:build": "node browser-collector/build.js",
    "browser-collector:test": "vitest run tests/browser-collector"
  },
  "keywords": [
    "equibets",
    "equestrian",
    "competition-data",
    "ingestion",
    "reconciliation"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.10.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "read-excel-file": "^9.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "vitest": "latest",
    "write-excel-file": "^4.1.1"
  }
}
